<!DOCTYPE html>
<html>
<head>
  <title>Shop</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-gray-100 min-h-screen">

  <h1 class="text-3xl font-bold text-center my-8">
    Available Bags
  </h1>

  <div class="flex flex-wrap gap-6 justify-center px-6">

    <% products.forEach(product => { %>

      <div class="w-64 p-4 rounded-xl shadow-md bg-white hover:shadow-xl transition">

        <img 
          src="<%= product.image %>" 
          alt="<%= product.name %>"
          class="w-full h-40 object-contain mb-4"
        />

        <h3 class="text-lg font-semibold mb-1">
          <%= product.name %>
        </h3>

        <p class="text-gray-700 font-medium">
          ₹<%= product.price %>
        </p>

        <% if(product.discount > 0){ %>
          <p class="text-green-600 text-sm">
            <%= product.discount %>% OFF
          </p>
        <% } %>

        <form action="/cart/add" method="POST" class="mt-4">
          <input type="hidden" name="productId" value="<%= product._id %>">

          <button
            type="submit"
            class="w-full bg-black text-white py-2 rounded-lg hover:bg-gray-800 transition"
          >
            Add to Cart
          </button>
        </form>

      </div>

    <% }) %>

  </div>

</body>
</html>
