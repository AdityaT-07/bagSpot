
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>My productdata</title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100 text-gray-800">

  <!-- Page Wrapper -->
  <div class="max-w-5xl mx-auto px-6 py-10">

    <!-- Heading -->
    <h1 class="text-3xl font-bold mb-8">
      My productdata
    </h1>

    <!-- productdata Card -->
    <div class="bg-white rounded-xl shadow p-6 flex flex-col md:flex-row gap-6">

      <!-- Product Image -->
      <div class="w-full md:w-1/3">
        <img
          src="/uploads/<%= productdata.image %>"
          alt="Product Image"
          class="w-full h-64 object-cover rounded-lg"
        />
      </div>

      <!-- Product Details -->
      <div class="flex-1 flex flex-col justify-between">

        <div>
          <h2 class="text-2xl font-semibold mb-2">
            <%= productdata.name %>
          </h2>

          <p class="text-gray-600 mb-4">
            Premium quality bag with durable material
          </p>

          <!-- Price Section -->
          <div class="flex items-center gap-3 mb-4">
            <span class="text-xl font-bold text-black">
              ₹<%= productdata.price %>
            </span>

            <% if(productdata.discount > 0) { %>
              <span class="text-sm text-green-600 font-medium">
                <%= productdata.discount %>% OFF
              </span>
            <% } %>
          </div>

          <!-- Quantity -->
          <div class="flex items-center gap-3">
            <span class="font-medium">Quantity:</span>

            <div class="flex items-center border rounded-lg overflow-hidden">
              <button class="px-3 py-1 bg-gray-100 hover:bg-gray-200">−</button>
              <span class="px-4">1</span>
              <button class="px-3 py-1 bg-gray-100 hover:bg-gray-200">+</button>
            </div>
          </div>
        </div>

        <!-- Actions -->
        <div class="flex gap-4 mt-6">
          <button class="flex-1 bg-black text-white py-2 rounded-lg hover:bg-gray-800 transition">
            Checkout
          </button>
          <button class="flex-1 border border-red-500 text-red-500 py-2 rounded-lg hover:bg-red-50 transition">
            Remove
          </button>
        </div>

      </div>
    </div>

  </div>

</body>
</html>
