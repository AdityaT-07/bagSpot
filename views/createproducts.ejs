<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin – Create Product</title>

  <!-- Tailwind CDN (browser build) -->
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-gray-100 text-gray-800">

  <!-- Layout Wrapper -->
  <div class="min-h-screen flex">

    <!-- Sidebar -->
    <aside class="w-64 bg-white shadow-md p-6 hidden md:flex flex-col">
      <h1 class="text-xl font-bold mb-6">Admin Panel</h1>

      <nav class="space-y-3">
        <a href="/products" class="block font-medium text-gray-700 hover:text-blue-600">
          All Products
        </a>
        <a href="/products/create" class="block font-medium text-blue-600">
          Create New Product
        </a>
      </nav>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 p-6 md:p-10">

      <!-- Card -->
      <div class="max-w-4xl mx-auto bg-white rounded-xl shadow p-8">

        <h2 class="text-2xl font-bold mb-6">
          Create New Product
        </h2>

        <form
          action="/products/create"
          method="POST"
          enctype="multipart/form-data"
          class="space-y-8"
          autocomplete="off"
        >

          <!-- Product Details -->
          <section>
            <h3 class="text-lg font-semibold mb-4">
              Product Details
            </h3>

            <div class="space-y-4">

              <div>
                <label class="block mb-1 font-medium">Product Image</label>
                <input
                  type="file"
                  name="image"
                  class="block w-full text-sm border rounded-lg cursor-pointer bg-gray-50"
                />
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <input
                  name="name"
                  type="text"
                  placeholder="Product Name"
                  class="input"
                />
                <input
                  name="price"
                  type="number"
                  placeholder="Product Price"
                  class="input"
                />
                <input
                  name="discount"
                  type="number"
                  placeholder="Discount (%)"
                  class="input"
                />
              </div>

            </div>
          </section>

          <!-- Panel Details -->
          <section>
            <h3 class="text-lg font-semibold mb-4">
              Panel Styling
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <input
                name="bgcolor"
                type="text"
                placeholder="Background Color"
                class="input"
              />
              <input
                name="panelcolor"
                type="text"
                placeholder="Panel Color"
                class="input"
              />
              <input
                name="textcolor"
                type="text"
                placeholder="Text Color"
                class="input"
              />
            </div>
          </section>

          <!-- Submit -->
          <div class="pt-4">
            <button
              type="submit"
              class="px-6 py-2 rounded-lg bg-blue-600 text-white font-semibold hover:bg-blue-700 transition"
            >
              Create Product
            </button>
          </div>

        </form>

      </div>

    </main>
  </div>

  <!-- Centralized Tailwind Utility -->
  <style>
    .input {
      @apply border rounded-lg px-4 py-2 w-full focus:outline-none focus:ring-2 focus:ring-blue-500;
    }
  </style>

</body>
</html>
